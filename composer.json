{
    "name": "mputkowski/laravel-discord-alerts",
    "description": "Post exception reports and custom messages to a Discord channel through a bot.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "discord", "alerts", "exceptions"],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "mputkowski\\DiscordAlerts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "mputkowski\\DiscordAlerts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "mputkowski\\DiscordAlerts\\DiscordAlertsServiceProvider"
            ],
            "aliases": {
                "DiscordAlerts": "mputkowski\\DiscordAlerts\\Facades\\DiscordAlerts"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
