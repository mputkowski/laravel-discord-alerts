{
    "name": "mputkowski/laravel-discord-alerts",
    "description": "Post exception reports and custom messages to a Discord channel through a bot.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "discord", "alerts", "exceptions"],
    "require": {
        "php": "^7.2|^8.0",
        "guzzlehttp/guzzle": "^6.3.1|^7.0",
        "illuminate/console": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/contracts": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^4.0|^5.0|^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^8.5|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "mputkowski\\DiscordAlerts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "mputkowski\\DiscordAlerts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "mputkowski\\DiscordAlerts\\DiscordAlertsServiceProvider"
            ],
            "aliases": {
                "DiscordAlerts": "mputkowski\\DiscordAlerts\\Facades\\DiscordAlerts"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
